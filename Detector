/*
 * Detector.kt - Explainable suspicious URL detection engine.
 *
 * The engine NEVER opens, requests or executes the submitted link. It only
 * parses the URL text and applies configurable heuristic rules. Each rule that
 * fires adds points to a 0-100 risk score and produces a plain-English reason.
 *
 * Optionally, if VT_API_KEY is configured, the URL string is looked up in
 * VirusTotal. A low score only means "no warning signs found" - it is NOT a
 * guarantee that a link is safe.
 */

const val DISCLAIMER =
    "A low score only means no warning signs were found by these automated rules. " +
        "It does NOT guarantee that a link is safe. Never enter passwords or " +
        "personal data on a site you do not fully trust."

private const val VT_API_BASE = "https://www.virustotal.com/api/v3"

class InvalidUrlException(message: String) : Exception(message)

