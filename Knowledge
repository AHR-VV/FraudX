            "Your device or files could be harmed.",
            listOf(
                "Do not download suspicious files.",
                "Do not install unknown applications.",
                "Run a trusted security scan if a file was opened."
            )
        ),

        ThreatCategory.SUSPICIOUS_REDIRECT to ThreatKnowledge(
            ThreatCategory.SUSPICIOUS_REDIRECT,
            "The scanner reported suspicious redirection behaviour.",
