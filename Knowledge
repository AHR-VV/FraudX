            listOf(
                "Do not follow unexpected redirects.",
                "Close suspicious pages.",
                "Open the intended website directly."
            )
        ),

        ThreatCategory.FAKE_PAYMENT to ThreatKnowledge(
            ThreatCategory.FAKE_PAYMENT,
            "Indicators suggest possible fraudulent payment activity.",
            "This payment page may be fake.",
            "You could lose money or payment information.",
            listOf(
                "Do not make the payment.",
                "Verify the merchant independently.",
                "Contact your bank if money was sent."
            )
