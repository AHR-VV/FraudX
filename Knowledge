        ThreatCategory.INSECURE_CONNECTION to ThreatKnowledge(
            ThreatCategory.INSECURE_CONNECTION,
            "The scanner reported a connection-security concern.",
            "Your connection may not be properly protected.",
            "Information could be exposed during transmission.",
            listOf(
                "Avoid entering sensitive information.",
                "Verify the connection.",
                "Use the official secure website."
            )
        )
    )

    fun get(category: ThreatCategory): ThreatKnowledge {
        return knowledge[category] ?: ThreatKnowledge(
            ThreatCategory.UNKNOWN,
            "The scanner supplied an unclassified threat indicator.",
            "We found something we cannot explain yet.",
            "The website could not be fully assessed.",
            listOf(
                "Avoid entering sensitive information.",
                "Use the official website.",
                "Try again after a complete scan."
            )
        )
    }

    fun all(): List<ThreatKnowledge> {
        return knowledge.values.toList()
    }
}

