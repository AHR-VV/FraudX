package com.fraudx.app.websiteprotection.knowledge

import com.fraudx.app.websiteprotection.models.*

data class ThreatKnowledge(
    val category: ThreatCategory,
    val technicalReason: String,
    val simpleReason: String,
    val consequence: String,
    val precautions: List<String>
)

