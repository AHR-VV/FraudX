    private val knowledge = mapOf(

        ThreatCategory.PHISHING to ThreatKnowledge(
            ThreatCategory.PHISHING,
            "Indicators suggest a website may attempt to collect sensitive information through deceptive content.",
            "This website may be trying to trick you.",
            "Your passwords or personal information could be stolen.",
            listOf(
                "Do not enter passwords.",
                "Check the website address carefully.",
                "Open the official website directly."
            )
        ),

        ThreatCategory.BRAND_IMPERSONATION to ThreatKnowledge(
            ThreatCategory.BRAND_IMPERSONATION,
            "The website contains indicators associated with brand impersonation.",
            "Someone may be pretending to be a trusted company.",
            "You could provide information to a fake company.",
            listOf(
                "Verify the official website.",
                "Do not trust logos alone.",
                "Contact the company through official channels."
            )
        ),

        ThreatCategory.CREDENTIAL_THEFT to ThreatKnowledge(
            ThreatCategory.CREDENTIAL_THEFT,
            "Evidence indicates possible credential collection.",
